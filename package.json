{
  "name": "petconnect",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.2.2",
    "eslint": "^10.11.0",
    "firebase-tools": "^15.30.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:backend": "npm --prefix backend/functions run build",
    "lint:backend": "eslint backend/functions/src backend/tests src/services",
    "format:backend": "prettier --check backend/functions/src backend/tests src/services backend/firebase.json backend/firebase/firestore.indexes.json",
    "typecheck": "tsc --noEmit",
    "check:backend": "npm run build:backend && npm run typecheck && npm run lint:backend && npm run format:backend",
    "test:backend:run": "tsx --test --test-concurrency=1 backend/tests/backend.test.ts",
    "test:backend": "npm run build:backend && firebase --config backend/firebase.json emulators:exec --project demo-petconnect --only auth,firestore,functions,storage \"npm run test:backend:run\"",
    "emulators": "npm run build:backend && firebase --config backend/firebase.json emulators:start --project demo-petconnect --only auth,firestore,functions,storage"
  },
  "private": true
}
