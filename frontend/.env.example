# Copy to frontend/.env.local. EXPO_PUBLIC_* values are embedded in the app.
EXPO_PUBLIC_FIREBASE_ENV=emulator

# In development, API and Auth requests automatically use the Expo server.
# This works with web, LAN, Android emulators and Expo Go tunnels.
# Leave these unset unless you intentionally use separate reachable services:
# EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Required for remote Expo push tokens in development/preview/production builds.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# For a real Firebase project, set ENV to dev/staging/production and supply
# the public Web SDK configuration plus an explicit API base URL.
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_API_BASE_URL=https://your-api.example
