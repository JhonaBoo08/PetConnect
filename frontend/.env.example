# Copy to frontend/.env.local. EXPO_PUBLIC_* values are embedded in the app.

EXPO_PUBLIC_FIREBASE_ENV=emulator
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Required for remote Expo push tokens in development/preview/production builds.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# For a real Firebase project, set ENV to dev/staging/production
# and provide the public Web SDK configuration for the same Firebase project
# used by the API's Admin SDK credentials.
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Android emulator: use 10.0.2.2 for emulator host/API base URL.
# Physical device: use your computer's reachable LAN IP during local testing.
