{
  "expo": {
    "name": "PetConnect",
    "slug": "PetConnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petconnect",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.petconnect.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DCE7DA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.petconnect.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PetConnect to use your camera to scan pet recovery QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PetConnect to use your location while you place recovery pins and view nearby lost pets."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "recovery"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose pet photos for profiles and recovery reports.",
          "cameraPermission": "Allow PetConnect to take a current pet photo for profile and recovery evidence.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F2",
          "image": "./assets/images/logo.png",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
