# Root/operator-only migration and backup environment.
# The migration user may have schema privileges; the running API user should not.

NODE_ENV=production

# Same-server MySQL.
MYSQL_SOCKET_PATH=/var/run/mysqld/mysqld.sock
MYSQL_USER=petconnect_migrator
MYSQL_PASSWORD=replace-with-a-long-random-migration-password
MYSQL_DATABASE=petconnect_db
MYSQL_SSL=false

# Remote/managed MySQL alternative: remove MYSQL_SOCKET_PATH, then use verified TLS.
# MYSQL_HOST=db.example.net
# MYSQL_PORT=3306
# MYSQL_SSL=true
# MYSQL_SSL_CA_PATH=/etc/petconnect/mysql-ca.pem

# Used by backup/restore so database rows and local media are treated as one dataset.
UPLOAD_DIR=/var/lib/petconnect/uploads
BACKUP_ROOT=/var/lib/petconnect/backups

# Optional when the MySQL CLI tools are not on PATH.
# MYSQL_BIN=/usr/bin/mysql
# MYSQLDUMP_BIN=/usr/bin/mysqldump
