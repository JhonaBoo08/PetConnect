# Copy to a private file such as /etc/petconnect/api.env.
# Never commit the real values.

NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=256kb

# Same-server MySQL: prefer the Unix socket. This avoids network exposure entirely.
MYSQL_SOCKET_PATH=/var/run/mysqld/mysqld.sock
MYSQL_USER=petconnect_app
MYSQL_PASSWORD=replace-with-a-long-random-runtime-password
MYSQL_DATABASE=petconnect_db
MYSQL_SSL=false

# Remote/managed MySQL alternative: remove MYSQL_SOCKET_PATH, then use verified TLS.
# MYSQL_HOST=db.example.net
# MYSQL_PORT=3306
# MYSQL_SSL=true
# MYSQL_SSL_CA_PATH=/etc/petconnect/mysql-ca.pem
# Or: MYSQL_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

FIREBASE_PROJECT_ID=replace-with-production-project-id
GOOGLE_APPLICATION_CREDENTIALS=/etc/petconnect/firebase-admin.json
# For platforms that cannot mount a private file, use this instead:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

CORS_ALLOWED_ORIGINS=https://pets.example.com
PUBLIC_APP_BASE_URL=https://pets.example.com

RECOVERY_TOKEN_SECRET=replace-with-at-least-32-random-bytes
RECOVERY_ALERT_RADIUS_KM=10

FINDER_SESSION_SECRET=replace-with-at-least-32-random-bytes
FINDER_IP_HASH_SECRET=replace-with-at-least-32-random-bytes
FINDER_SESSION_TTL_DAYS=30
FINDER_EVIDENCE_MAX_BYTES=8388608
FINDER_EVIDENCE_RETENTION_HOURS=24
FINDER_INCIDENT_RETENTION_DAYS=30
FINDER_CLEANUP_INTERVAL_MS=3600000
FINDER_SESSION_RATE_LIMIT_HOURLY=20
FINDER_EVIDENCE_RATE_LIMIT_HOURLY=12
FINDER_SUBMISSION_RATE_LIMIT_15M=12
FINDER_OTP_RATE_LIMIT_HOURLY=10
FINDER_OTP_VERIFY_RATE_LIMIT_HOURLY=50
FINDER_OTP_SECRET=replace-with-at-least-32-random-bytes
FINDER_OTP_TTL_SECONDS=600
FINDER_OTP_EXPOSE_CODE=false

# Choose one production OTP provider.
FINDER_OTP_PROVIDER=webhook
FINDER_OTP_WEBHOOK_URL=https://sms.example.net/send
# FINDER_OTP_WEBHOOK_TOKEN=replace-with-provider-token
# Or:
# FINDER_OTP_PROVIDER=smsgate
# SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1
# SMSGATE_USERNAME=replace-with-smsgate-user
# SMSGATE_PASSWORD=replace-with-smsgate-password

# Durable single-server storage.
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_LOCAL_DURABLE=true
UPLOAD_DIR=/var/lib/petconnect/uploads

# For an ephemeral/PaaS application server, use Cloudinary instead:
# UPLOAD_STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=replace-with-cloudinary-secret

NOTIFICATION_WORKER_INTERVAL_MS=60000

# Optional when Expo Push enhanced security is enabled.
# EXPO_ACCESS_TOKEN=replace-with-server-side-expo-access-token
