# Public values embedded into the web/native bundle.
# Copy to an ignored file such as .deployment/frontend.env.

EXPO_PUBLIC_FIREBASE_ENV=production
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-with-production-project-id
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-auth-domain
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-web-app-id
EXPO_PUBLIC_API_BASE_URL=https://pets.example.com

# Required for production push tokens in native EAS builds.
# EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-uuid
