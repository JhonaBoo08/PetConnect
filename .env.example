# Safe default: all app requests go to local emulators and local API server.
EXPO_PUBLIC_FIREBASE_ENV=emulator
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# For physical devices, set EXPO_PUBLIC_API_BASE_URL to your computer's LAN IP (e.g. http://192.168.x.x:3000)
# For dev/staging, obtain these public values from that project's Web app settings.
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_APP_ID=
