# Copy this file to frontend/.env.local. Expo reads EXPO_PUBLIC_* at bundle time.
# No Firebase project is needed for the local Auth emulator.
EXPO_PUBLIC_FIREBASE_ENV=emulator
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# Required for real remote Expo push tokens in a development/production build.
# EXPO_PUBLIC_EAS_PROJECT_ID=

# For an Android emulator, use 10.0.2.2 instead of 127.0.0.1 for both
# EXPO_PUBLIC_EMULATOR_HOST and EXPO_PUBLIC_API_BASE_URL.
# For a physical device, use your computer's reachable LAN IP for both.

# To use your own Firebase project, change ENV to dev, staging, or production,
# then fill in your Firebase Web app's public config below. The API must use
# the same project ID and Admin SDK credentials.
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend-only settings belong in backend/api/.env (not frontend/.env.local):
# NOTIFICATION_WORKER_INTERVAL_MS=60000
