# PetConnect API local development template.
# Copy to backend/api/.env. Never commit the real .env file.

NODE_ENV=development
PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=petconnect_db

# Local Firebase Auth emulator. Remove FIREBASE_AUTH_EMULATOR_HOST in production.
FIREBASE_PROJECT_ID=demo-petconnect
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Production VM: set GOOGLE_APPLICATION_CREDENTIALS to a protected Admin JSON
# file outside the repository. Never expose it to Expo.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/petconnect/firebase-admin.json
# FIREBASE_SERVICE_ACCOUNT_JSON is an alternative for hosts without a private file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
PUBLIC_APP_BASE_URL=http://127.0.0.1:8081

# Local-only example. Replace with a cryptographically random secret in any
# shared/staging/production deployment; minimum 32 bytes.
RECOVERY_TOKEN_SECRET=change-this-local-secret-32-bytes-minimum
RECOVERY_ALERT_RADIUS_KM=10
NOTIFICATION_WORKER_INTERVAL_MS=60000

# Use an absolute durable path in production. This folder must be backed up
# together with MySQL because pet records store image URLs.
UPLOAD_DIR=./uploads

JSON_BODY_LIMIT=256kb
TRUST_PROXY_HOPS=0

# Optional when Expo Push enhanced security is enabled.
# EXPO_ACCESS_TOKEN=

# Optional DB CLI overrides for backup/restore when mysql/mysqldump are not PATH.
# MYSQL_BIN=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
# MYSQLDUMP_BIN=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
